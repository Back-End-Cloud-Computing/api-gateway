# Cópia de referência. Nada aqui é segredo: o gateway não conhece x-internal-secret.
PORT=3000
METRICS_PORT=9100
LOG_LEVEL=info

# authorization: de onde vem a chave pública (GET /auth/public-key) e o emissor esperado
AUTH_BASE_URL=http://authorization:8081
JWT_ISSUER=ganjj-authorization
# PEM estático opcional; se definido, não busca no boot
JWT_PUBLIC_KEY=

# Upstreams (Service:porta no cluster)
CLIENT_URL=http://client:8082
ORDER_URL=http://order:8080
CART_URL=http://shopping-cart:3003
PRODUCT_URL=http://product-api:8000
PROMOTION_URL=http://promotion:8000

UPSTREAM_TIMEOUT_MS=10000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_AUTH_MAX=10
# Origens permitidas separadas por vírgula; vazio desliga o CORS
CORS_ORIGINS=
